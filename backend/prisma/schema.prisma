// AQX Sports Intelligence — Prisma schema
// =========================================
// SQLite via the better-sqlite3 driver adapter (Prisma 7 uses driver adapters natively).
//
// Domain models (leagues, teams, players, matches, injury models, EV models, ...)
// are added phase by phase.
//
// NOTE: The connection URL lives in `prisma.config.ts` (Prisma 7 style), not here.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}
