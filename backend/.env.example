# --- General ---
PORT=
NODE_ENV=
APP_NAME=

# --- Database (SQLite via better-sqlite3 driver adapter) ---
DATABASE_URL="file:./prisma/aqx.db"

# --- Python ML Service ---
PYTHON_ML_URL=

# --- Cache TTL Settings (seconds) ---
CACHE_TTL_SHORT=
CACHE_TTL_MEDIUM=
CACHE_TTL_LONG=

# --- Rate Limiting ---
# Sliding window in ms (default 900000 = 15 min). Health + /api/docs are
# always exempt so the app's health ping and the demo docs can never be blocked.
RATE_LIMIT_WINDOW_MS=
# Max requests per window per IP (default 600 — demo-sized).
RATE_LIMIT_MAX=

# --- Logging ---
LOG_LEVEL=

# --- CORS ---
ALLOWED_ORIGINS=

# --- Data Sources ---
# BallDontLie (NBA) — API key from https://balldontlie.io
BALLDONTLIE_API_KEY=
# BallDontLie request pacing (req/min): free tier is 5, ALL-STAR 60, GOAT 600
BALLDONTLIE_RATE_LIMIT=5

# --- Job Control (Phase 6 Step 10) ---
# Secret for POST /api/jobs/trigger — the X-Admin-Key header must match.
# When unset the trigger route is disabled (fail-closed).
JOB_CONTROL_ADMIN_KEY=
# Cron overrides for the background jobs (defaults: data_sync every 6h,
# risk_compute 1h after sync, momentum once daily, cleanup + health_check daily).
# JOB_CRON_DATA_SYNC="0 0,6,12,18 * * *"
# JOB_CRON_RISK_COMPUTE="0 1,7,13,19 * * *"
# JOB_CRON_MOMENTUM="0 2 * * *"
# JOB_CRON_CLEANUP="0 3 * * *"
# JOB_CRON_HEALTH_CHECK="*/15 * * * *"

# --- Optional AI ---
OPENAI_API_KEY=
