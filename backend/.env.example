# --- Server ---
NODE_ENV=development
PORT=4000

# --- Database (SQLite via better-sqlite3 driver adapter) ---
# Path is relative to the backend/ project root (both CLI and runtime resolve it the same way)
DATABASE_URL="file:./prisma/dev.db"

# --- CORS ---
# "*" allows all origins. For multiple origins use a comma-separated list: https://a.com,https://b.com
CORS_ORIGIN=*

# --- Caching (node-cache, in-memory) ---
CACHE_TTL_SECONDS=300

# --- Logging ---
LOG_LEVEL=debug
