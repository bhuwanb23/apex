# AQX ML Microservice — environment (copy to .env)
PORT=8001
LOG_LEVEL=INFO
# Comma separated — Node backend + frontend may call directly
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000
# Optional: enables richer OpenAI story generation (Step 9)
OPENAI_API_KEY=
# Optional: path to a fitted win-probability model (joblib). Default:
# <python_ml>/models/wp_model.joblib. Trained lazily on first use.
WP_MODEL_PATH=
# Optional: JSON/CSV training data for the WP model (auto-trained when set).
WP_TRAINING_DATA=
# Optional: fitted timeout decision-tree model (joblib). Falls back to rules.
TIMEOUT_MODEL_PATH=
# Optional: JSON training data for the timeout tree (auto-trained when set).
# Records: [{consecutiveScores, scoreDiff, timeRemaining, period,
#            timeoutsAvailable, timeoutCalled, stop}] where stop is 0/1.
TIMEOUT_TRAINING_DATA=
# Optional: OpenAI story enhancement (Step 9). Only used when the key is set
# AND the role is analyst/journalist; templates otherwise. Fan is never sent.
OPENAI_MODEL=gpt-3.5-turbo
