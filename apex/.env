# Apex backend base URL.
#
# When this is NOT set, the app auto-detects the backend host:
#   - Web / simulators  -> http://localhost:8000
#   - Phone in Expo Go  -> http://<this-machine's-LAN-IP>:8000 (derived from
#                          the Expo dev-server host, so the phone reaches the
#                          laptop's backend instead of calling its own
#                          localhost). No edit needed for the demo — just make
#                          sure the phone and laptop are on the same WiFi and
#                          the backend is running.
#
# Only set this to force a fixed address (staging / production / a specific
# machine IP):
# EXPO_PUBLIC_API_URL=http://192.168.1.50:8000
EXPO_PUBLIC_ADMIN_KEY=dev-admin-key-2026
